# Krutrim API
KRUTRIM_API_KEY=your_krutrim_api_key_here
KRUTRIM_MODEL=gpt-oss-120b

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dr-narayan-dutt
MONGODB_COLLECTION=books
MONGODB_INDEX_NAME=vector_index

# PDF source (local ingestion only)
PDF_PATH=./data/raw/saundarya.pdf
PROCESSED_TEXT_DIR=./data/processed

# Embedding model (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
HF_TOKEN=your_huggingface_token_here
# Set to 1 once the model is cached locally — skips all remote HF HTTP calls
HF_HUB_OFFLINE=1

# LLM settings
LLM_TEMPERATURE=0.7

# LlamaCloud (document parsing / OCR — optional)
LLAMA_CLOUD_API_KEY=llx-your_llamacloud_key_here

# Redis (session memory + Celery broker)
REDIS_URL=redis://localhost:6379

# Celery (background article generation — optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Admin API auth — required for /admin/* endpoints (they 503 if unset)
ADMIN_SECRET=change_me_to_a_long_random_string

# CORS — comma-separated allowed origins for the frontend (avoid "*" in production)
CORS_ORIGINS=http://localhost:3000
