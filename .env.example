# Krutrim API
KRUTRIM_API_KEY=your_krutrim_api_key_here
KRUTRIM_MODEL=gpt-oss-120b

# MongoDB Atlas
MONGODB_URI = "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Connection"
MONGODB_DB_NAME=dr-narayan-dutt
MONGODB_COLLECTION=books
MONGODB_INDEX_NAME=vector_index

# PDF source
PDF_PATH=./data/raw/saundarya.pdf
PROCESSED_TEXT_DIR=./data/processed

# Embedding model (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
HF_TOKEN=hf_your_token_here
# Set to 1 once the model is cached locally — skips all remote HF HTTP calls
# HF_HUB_OFFLINE=1
# LLM settings
LLM_TEMPERATURE=0.7
LLAMA_CLOUD_API_KEY="your_llama_cloud_key_here"

# Google sign-in (optional login). Create an OAuth "Web application" client ID in
# Google Cloud Console → APIs & Services → Credentials, with Authorized JavaScript
# origins http://localhost:3000 (+ your production domain). No client secret needed.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# Signs session tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me
# true in production (HTTPS) so the session cookie is only sent over TLS
COOKIE_SECURE=false
# Comma-separated frontend origins allowed to call the API with cookies (no "*")
CORS_ORIGINS=http://localhost:3000
# Questions per 30 minutes: anonymous (per IP) and signed-in (per user)
RATE_LIMIT_ANON=10
RATE_LIMIT_USER=30
